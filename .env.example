# ==============================================================================
# ReadBox Production & Self-Hosting Environment Template (Docker Compose / Coolify)
# Copy to .env for production Compose. Never commit .env to Git.
# Production uses docker-compose.yml; local dev uses compose.dev.yaml.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. COOLIFY AUTO-GENERATED SECRETS (Do NOT set manually in Coolify unless overriding)
# Coolify automatically generates these on first deploy and persists them across updates.
# ------------------------------------------------------------------------------
SERVICE_PASSWORD_DB=
SERVICE_BASE64_64_SECRET=
# Standalone QIS installer creates these once. Never store the plaintext setup code.
READBOX_SETUP_TOKEN_SHA256=
READBOX_SETUP_TOKEN_EXPIRES_AT=
POSTFIX_LOOKUP_PASSWORD=
# Optional public age recipient needed for encrypted safe updates.
READBOX_BACKUP_RECIPIENT=

# ------------------------------------------------------------------------------
# 2. DATABASE CONNECTION (PostgreSQL 16 — Single Authoritative Database)
# docker-compose.yml derives a percent-encoded DATABASE_URL inside the app containers
# from SERVICE_PASSWORD_DB. Do NOT manually interpolate or duplicate this secret.
# DATABASE_URL below is only for non-container local development (see README).
# Postfix virtual lookup maps use mailserver.postfix_virtual_* views in the same DB.
# ------------------------------------------------------------------------------
POSTGRES_USER=readbox
POSTGRES_DB=readbox
DATABASE_URL=
PRISMA_CLI_ALLOW_REMOTE=true

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & REVERSE PROXY
# For Coolify/Traefik/Caddy HTTPS termination, keep AUTH_TRUST_HOST=true and TRUST_PROXY_HEADERS=true.
# ------------------------------------------------------------------------------
AUTH_ENABLED=true
# Non-Docker process only (min 32 characters); Docker uses SERVICE_BASE64_64_SECRET.
AUTH_SECRET=
AUTH_TRUST_HOST=true
TRUST_PROXY_HEADERS=true
# Optional explicit canonical URL (e.g. https://mail.example.com)
AUTH_URL=
PUBLIC_SITE_ORIGIN=
# Optional HMAC key override for public contact CSRF tokens (defaults to AUTH_SECRET when set)
CONTACT_SECRET_KEY=

# Development-only auth helpers (always forced to "off" when NODE_ENV=production)
DEV_AUTH_MODE=off
DEV_AUTH_ROLE=user

# Login rate limiting & logging
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 4. DOMAIN, MAIL HOST & SERVER NETWORKING (Set in Coolify UI for your domain)
# ------------------------------------------------------------------------------
MAIL_DOMAIN=readbox.local
MAIL_HOSTNAME=mail.readbox.local
APP_HOSTNAME=app.readbox.local
SERVER_IP=127.0.0.1
DNS_LOOKUP_TIMEOUT_SECONDS=3
# DKIM-01 optional Cloudflare DNS-only zone-scoped token (Zone Read + DNS Edit).
# No token = manual TXT copy/export. Do not store production values in Git.
READBOX_CF_DNS_TOKEN=
READBOX_CF_DNS_ZONE_ID=
READBOX_CF_DNS_ZONE_NAME=

# ------------------------------------------------------------------------------
# 5. STORAGE, WORKER & MAILBOX POLICY (Backed by named volumes in docker-compose.yml)
# ------------------------------------------------------------------------------
MAIL_STORAGE_ROOT=/var/vmail
ATTACHMENT_STORAGE_ROOT=/var/lib/readbox/attachments
MEDIA_ROOT=/var/lib/readbox/media
MAILBOX_PROVISION_LOCK_ROOT=/var/lock/readbox-provision
OPENDKIM_KEYS_ROOT=/etc/opendkim/keys
INGESTION_LOCK_FILE=/var/lock/readbox-provision/readbox-ingestion.lock

MAILBOX_DEFAULT_QUOTA_BYTES=2147483648
INGESTION_STALE_AFTER_SECONDS=120
INGESTION_INTERVAL_SECONDS=15
# Set "true" to require a fresh maildir_ingestion worker heartbeat for /health/ready 200 OK
REQUIRE_INGESTION_READY=false
MAX_MESSAGE_SIZE_MB=25
MAX_ATTACHMENT_SIZE_MB=20
MAX_ATTACHMENTS_PER_MESSAGE=25

# Optional Nginx X-Accel-Redirect acceleration ("false" for standalone Next.js container)
USE_X_ACCEL_REDIRECT=false

# ------------------------------------------------------------------------------
# 6. SYSTEM UPDATE / RELEASE METADATA (Optional)
# ------------------------------------------------------------------------------
UPDATE_GITHUB_REPO=vibtools/ReadBox
UPDATE_RUNTIME_DIR=/run/readbox
UPDATE_SERVICE_NAME=readbox-updater.service
UPDATE_SCRIPT_PATH=/opt/readbox/app/scripts/updater/upgrade.sh